// Cloudflare Workers config. The site is a static SPA: `npm run build` writes
// dist/, and Cloudflare serves it, falling back to index.html for client routes.
{
  "name": "site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
